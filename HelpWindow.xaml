<Window x:Class="ImageAndMp4WebBuilder.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Image and MP4 Thumbnail Browser - Help" FontSize="16" FontWeight="Bold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    Use this app to browse a folder of images (.png, .jpg, .jpeg) and videos (.mp4). Thumbnails are created in a 'thumbnails' subfolder.
                </TextBlock>
                <Separator Margin="0,8,0,8" />
                <TextBlock TextWrapping="Wrap">
                    1. Select Folder: Choose a folder. Thumbnails will be generated dynamically if missing and a loading progress bar will appear.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    2. Navigation: Use Prev/Next to change pages. Use left and right arrow keys to easily navigate between images in full-screen lightbox.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    3. Open Items: Click a thumbnail. Images open in a preview inside the app; videos open with your default system player.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    4. Ignore NSFW Checkbox: If checked, subdirectories with 'NSFW' in their name are ignored during export. If unchecked, '_NSFW' is automatically appended to the generated page filenames.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    5. Export HTML: Generates paged HTML files. Existing pages are automatically moved to 'HtmlBackup'. If subfolders exist without an HTML index file, an 'out.txt' relative link to the main index is generated.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    6. Subdirectory Integration: If any subdirectory contains an HTML index file named exactly 'SubfolderName.html', a quick link to it will be embedded under the 'Subfolders:' header on the generated index pages.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                    7. Keyboard: Press Ctrl+H anytime to show this help, or use the dedicated toolbar Help button.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Height="26" Margin="0,10,0,0" IsDefault="True" Content="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
